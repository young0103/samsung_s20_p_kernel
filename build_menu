#!/usr/bin/env bash
###############################################################################
#  LIGHTNING‑KERNEL‑BUILD  – y2q (SM‑G986N Snapdragon)  ########################
###############################################################################
set -euo pipefail
IFS=$'\n\t'

### 0. 공통 함수 ##############################################################
log() { printf "\e[1;34m%s\e[0m\n" "$*"; }

clone_if_missing() {             # $1=url  $2=dest  [$3=branch]
  [[ -d "$2/.git" ]] || git clone --depth=1 ${3:+--branch "$3"} "$1" "$2"
}

### 1. 저장소 클론 ############################################################
log ">>> Cloning dependencies"
clone_if_missing https://github.com/young0103/samsung_s20_p_kernel kernel stock_s20_p
cd kernel
clone_if_missing https://github.com/prorooter007/android_prebuilts_clang_host_linux-x86_clang-6877366 \
                 clang-r383902
clone_if_missing https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/\
aarch64/aarch64-linux-android-4.9 aarch64-linux-android-4.9 android-11.0.0_r48
clone_if_missing https://github.com/osm0sis/AnyKernel3 AnyKernel3
log ">>> Dependency cloning done"

### 2. 환경 변수 ##############################################################
export ARCH=arm64
export LLVM=1 LLVM_IAS=1               # Clang 통합 어셈블러
export CLANG_PATH=$PWD/clang-r383902/bin
export PATH=$CLANG_PATH:$PATH
export CROSS_COMPILE=aarch64-linux-gnu- # Ubuntu 패키지(gcc‑aarch64‑linux‑gnu)
OUT_DIR=$PWD/out
mkdir -p "$OUT_DIR"

### 3. GSI 패치 ###############################################################
log ">>> Applying GSI patch"
git apply --check gsi-commits.patch && git apply gsi-commits.patch

### 4. 커널 빌드 ##############################################################
log ">>> Building kernel"
make O="$OUT_DIR"   vendor/y2q_kor_singlex_defconfig
make -j"$(nproc)"  O="$OUT_DIR" CC=clang LD=ld.lld \
     LOCALVERSION=-Lightning-V2.5

### 5. DTB/DTBO 이미지 ########################################################
if [[ -f dt.configs/y2q.cfg ]]; then
  tools/mkdtimg cfg_create "$OUT_DIR/dtb.img" dt.configs/y2q.cfg \
    -d arch/arm64/boot/dts
fi

### 6. AnyKernel3 리패킹 ######################################################
log ">>> Re‑packing AnyKernel3"
cd AnyKernel3
git reset --hard
cp ../"$OUT_DIR"/Image zImage
[[ -f ../"$OUT_DIR"/dtbo.img ]] && cp ../"$OUT_DIR"/dtbo.img dtbo.img
zip -r9 "../$OUT_DIR/y2q_kernel_${CIRCLE_SHA1:-local}.zip" . -x '*.git*'

### 7. (CircleCI 전용) 산출물 업로드 ###########################################
# config.yml 예시:
# - store_artifacts:
#     path: out/y2q_kernel_${CIRCLE_SHA1}.zip
#     destination: kernels/
###############################################################################
log ">>> Build finished – artifact at $OUT_DIR"
